# Copie para .env.local e preencha. Nunca versione segredos.

# Número do WhatsApp da SA, só dígitos: 55 + DDD + número.
# Vazio usa o comercial da SA, (38) 99893-4902. Para testar sem mandar
# mensagem para a SA, ponha o seu número aqui.
NEXT_PUBLIC_WHATSAPP_NUMBER=5538998934902

# Endereço público do site (canônico, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://saagencia.com.br

# Webhook do CRM que recebe o lead (POST JSON). Vazio: em desenvolvimento o
# corpo aparece no console do servidor; em produção o lead chega só pelo WhatsApp.
CRM_WEBHOOK_URL=

# Token opcional do CRM, enviado como "Authorization: Bearer <token>".
CRM_WEBHOOK_TOKEN=

# ID do Google Tag Manager (GTM-XXXXXXX). Só carrega depois do "Aceitar" no aviso de cookies.
NEXT_PUBLIC_GTM_ID=

# Métricas próprias (só depois do "Aceitar"). URL do Postgres onde rodou
# db/metricas.sql. Vazio: em desenvolvimento o resumo aparece no console;
# em produção os eventos são descartados.
EVENTOS_DATABASE_URL=

# Sal secreto para o código diário do IP. Qualquer texto longo e aleatório.
EVENTOS_SAL=
